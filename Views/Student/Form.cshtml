@model DemoMvc551.Models.Student

@{
    ViewData["Title"] = "Nhập thông tin sinh viên";
}

<h2>@ViewData["Title"]</h2>

<div asp-validation-summary="ModelOnly" style="color: red; font-weight: bold;"></div>

<form asp-action="Form" method="post">

    <div>
        <label asp-for="UserName">Họ tên:</label><br />
        <input asp-for="UserName" />
        <span asp-validation-for="UserName" style="color:red"></span>
    </div>

    <div style="margin-top:10px;">
        <label asp-for="StudentId">Mã sinh viên:</label><br />
        <input asp-for="StudentId" />
        <span asp-validation-for="StudentId" style="color:red"></span>
    </div>

    <div style="margin-top:10px;">
        <label asp-for="BirthYear">Năm sinh:</label><br />
        <input asp-for="BirthYear" type="number" />
        <span asp-validation-for="BirthYear" style="color:red"></span>
    </div>

    <button type="submit" style="margin-top:15px;">Gửi thông tin</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}